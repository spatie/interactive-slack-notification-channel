{
    "name": "spatie/interactive-slack-notification-channel",
    "description": "Send interactive Slack notifications in Laravel apps",
    "keywords": [
        "spatie",
        "interactive-slack-notification-channel"
    ],
    "homepage": "https://github.com/spatie/interactive-slack-notification-channel",
    "license": "MIT",
    "authors": [
        {
            "name": "Freek Van der Herten",
            "email": "freek@spatie.be",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "ext-json": "*",
        "mockery/mockery": "^1.4",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "phpunit/phpunit": "^11.5.3|^12.0",
        "spatie/ray": "^1.27",
        "spatie/test-time": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "Spatie\\InteractiveSlackNotificationChannel\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spatie\\InteractiveSlackNotificationChannel\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spatie\\InteractiveSlackNotificationChannel\\InteractiveSlackNotificationChannelServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
